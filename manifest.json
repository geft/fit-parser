{
  "manifest_version": 3,
  "name": "Garmin FIT → CSV Exporter",
  "version": "1.1.0",
  "description": "Export your latest Garmin Connect run as a parsed CSV for AI analysis",
  "permissions": [
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://connect.garmin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://connect.garmin.com/*"],
      "js": ["page-fetch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://connect.garmin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
